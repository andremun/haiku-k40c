{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "sudo*": "ask",
      "su *": "ask",
      "doas *": "ask",
      "pkexec*": "ask",
      "modprobe*": "ask",
      "rmmod*": "ask",
      "insmod*": "ask",
      "setpci*": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "mount *": "ask",
      "umount *": "ask",
      "reboot*": "ask",
      "shutdown*": "ask",
      "systemctl*": "ask",
      "nvidia-smi -*": "ask",
      "nvidia-smi --*": "ask",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "git rebase*": "ask",
      "git filter-branch*": "ask",
      "rm -rf*": "ask",
      "rm -fr*": "ask",
      "curl*": "ask",
      "wget*": "ask",
      "apt*": "ask",
      "pip install*": "ask",
      "opencode*": "ask",
      "qemu*": "ask",
      "*vfio*": "ask"
    },
    "edit": {
      "*": "allow",
      "reference/*": "deny",
      "reference/**": "deny",
      "docs/design/*": "deny",
      "AGENTS.md": "ask",
      "opencode.json": "deny",
      ".opencode/*": "deny",
      ".opencode/**": "deny",
      "tools/haiku/*": "ask",
      "LICENSE": "deny",
      "tests/accept/*": "deny"
    },
    "webfetch": "ask",
    "task": "deny",
    "external_directory": {
      "*": "ask",
      "/home/unimelb.edu.au/mariom1/llm-server/agent-refs/*": "allow",
      "/home/unimelb.edu.au/mariom1/llm-server/agent-refs/**": "allow",
      "/home/unimelb.edu.au/mariom1/haiku-cross/*": "allow",
      "/home/unimelb.edu.au/mariom1/haiku-cross/**": "allow"
    },
    "read": {
      "*": "allow",
      "*analysis/callgraph.json": "deny",
      "*analysis/callgraph.md": "deny",
      "*registers/mmio_accesses.json": "deny",
      "*tools/check_repo.py": "deny"
    }
  }
}
