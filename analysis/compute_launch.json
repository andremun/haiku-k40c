  "code_address": {
    "description": "The shader code (SASS text section) reaches the GPU through CODE_ADDRESS_HIGH in nve4_screen_compute_setup (line 83), which sets screen->text->offset. In nve4_launch_grid (line 872), the LAUNCH_DESC_ADDRESS method receives desc_gpuaddr pointing to the QMD descriptor buffer. The QMD's PROGRAM_OFFSET field (set at line 591 via cp->code_base) contains the GPU address of the shader code relative to the descriptor. The kernel driver resolves these offsets to actual GPU addresses via the channel's address space.",
    "setup_line": 83,
    "launch_line": 872,
    "desc_field_line": 591
  },
